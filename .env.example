# ---- REQUIRED: pick ONE database (not both) ----

# RECOMMENDED: Postgres (Neon) -> free, real SQL database, 10 MB attachments.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Alternative: Firebase Firestore (whole service-account JSON on ONE line).
# Leave DATABASE_URL out if you use this. Attachments are limited to 700 KB each.
FIREBASE_SERVICE_ACCOUNT=

# ---- REQUIRED: login ----
ADMIN_USERNAME=owner
ADMIN_PASSWORD=change-this-to-a-strong-password

# ---- RECOMMENDED ----
# Long random string used to sign login cookies (e.g. 40+ random characters).
SESSION_SECRET=

# ---- OPTIONAL ----
# Max size of one attachment in MB (default 10; auto-capped to ~0.68 MB on Firestore).
# On Netlify/Vercel keep this at 4 or less (their request-size limits are ~6 MB / 4.5 MB).
MAX_UPLOAD_MB=4
# Set to false only if your Postgres does not use SSL
DATABASE_SSL=true
